# =====================================================
# BookPass Environment Variables Template
# =====================================================
# Copy this file to your Hetzner server as /opt/bookpass/.env
# Fill in the actual values (without quotes)
# =====================================================

# GitHub username (for pulling images from GHCR)
GITHUB_USERNAME=your-github-username

# Database password
DB_PASSWORD=your-db-password-here

# JWT Secret for authentication
JWT_SECRET=your-jwt-secret-here

# Moyasar payment API key
MOYASAR_SECRET_KEY=your-moyasar-key-here
